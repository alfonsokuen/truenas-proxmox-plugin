[Unit]
Description=TrueNAS Proxmox Plugin Session Broker
Documentation=https://github.com/truenas/truenas-proxmox-plugin
After=network-online.target
Wants=network-online.target
# GitHub #132: order the broker BEFORE the PVE services that call into
# the plugin. Without this, at boot pvestatd/pvedaemon can start before
# the broker's Unix socket is listening, fall back to direct-WS auth
# against TrueNAS, and trip auth.login_with_api_key rate limits —
# locking the storage out for a 10-minute cooldown and preventing
# graphical.target from being reached.
Before=pvestatd.service pvedaemon.service pveproxy.service

[Service]
# Type=notify pairs with sd_notify_ready() in the broker, which sends
# READY=1 only after binding the listen socket and forking a worker.
# Downstream services with After=truenas-plugin-broker.service then
# wait until the broker can accept connections.
Type=notify
NotifyAccess=main
# A lost READY=1 would otherwise hold the start for the 90 s default and then kill
# a broker that is in fact serving. Fail fast and let Restart= retry.
TimeoutStartSec=30
# On TERM the parent signals the workers, unpublishes the socket and exits at
# once, so a restart starts the next broker within seconds instead of after
# the slowest in-flight RPC. Each worker finishes the request it accepted and
# exits on its own (bounded by its own alarm, the window below). KillMode=process
# keeps systemd from SIGKILLing those workers when the parent exits; systemd
# will log "left-over process" for them when the next broker starts, which is
# expected. The stop timeout still covers the default 90 s RPC budget, 10 s
# each for request and response framing, plus worker cleanup. If raising either
# broker budget above 90 s, also set this above that budget plus 25 s.
KillMode=process
TimeoutStopSec=120
ExecStart=/usr/sbin/truenas-plugin-broker --foreground
Restart=on-failure
RestartSec=2
RuntimeDirectory=truenas-plugin
RuntimeDirectoryMode=0700
# Keep /run/truenas-plugin across service restarts so the preflight-alloc
# cache stamps written by pvedaemon workers survive broker upgrades.
# Tmpfs is still wiped on reboot, which is the correct invalidation
# surface for cached TN health signals.
RuntimeDirectoryPreserve=yes
StandardOutput=journal
StandardError=journal
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
