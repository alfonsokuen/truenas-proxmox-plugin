#!/usr/bin/perl
# truenas-plugin-broker
#
# Holds one persistent authenticated WebSocket per (host, api_key) pair to
# the TrueNAS middleware and proxies JSON-RPC for any number of local PVE
# plugin clients via a Unix socket.
#
# Goal: every PVE plugin invocation (forked qm/pvesh/pveproxy worker, every
# pvedaemon process) reuses the broker's WS instead of opening a fresh one.
# TrueNAS rate-limits auth.login_with_api_key at 20 calls / 60 s / IP /
# method, so per-process re-auth used to trip a sticky 60 s lockout
# (death-spiral D2). With the broker, the node logs in once per upstream
# session and never re-auths under normal operation.
#
# Protocol (newline-delimited JSON over Unix socket):
#   client -> broker:
#     {"scfg":{"api_host":"...","api_key":"...","api_scheme":"wss",
#              "api_insecure":0,"prefer_ipv4":1,"api_port":443},
#      "method":"system.version","params":[],
#      "timeout":30,"sent_mono":123456.789}
#   broker -> client:
#     {"result":...}            on success
#     {"error":"..."}           on failure (string contains TN error body)
#
# Trust model: Unix socket is root-only (mode 0600). API keys are passed
# in each request because the broker is stateless w.r.t. credentials.

use strict;
use warnings;
use IO::Socket::UNIX;
use IO::Socket::SSL;
use IO::Socket::INET;
use IO::Select;
use Fcntl qw(:flock);
use Errno qw(EAGAIN EWOULDBLOCK EINTR);
use POSIX qw(setsid strftime WNOHANG);
use Digest::SHA qw(sha1 sha1_hex);
use MIME::Base64 qw(encode_base64);
use JSON::PP ();
# Same choice as the plugin (see the comment in TrueNASPlugin.pm): the broker decodes
# every TrueNAS answer, and JSON::PP spends ~260 ms decoding a 350 KB answer where
# JSON::XS spends ~5 ms. Only DECODING uses XS: JSON::XS 4.04 on Perl 5.40 encodes a
# number that was ever used as a string as a JSON string, and the requests this
# broker builds (ids, parameters relayed to TrueNAS) must keep their types.
BEGIN {
    my $xs = !$ENV{TRUENAS_PLUGIN_JSON_PP} && eval { require JSON::XS; JSON::XS->VERSION(4.0); 1 };
    no strict 'refs';
    *encode_json = \&JSON::PP::encode_json;
    *decode_json = $xs ? \&JSON::XS::decode_json : \&JSON::PP::decode_json;
}
# IPPROTO_TCP is not in Socket's default export list; the keepalive tuning
# below needs it by name.
use Socket qw(inet_ntoa getaddrinfo getnameinfo AF_INET SOCK_STREAM NI_NUMERICHOST NIx_NOSERV IPPROTO_TCP);
use Time::HiRes qw(time);
# TrueNAS::SCRAM (and the Crypt::PBKDF2 / Crypt::URandom it needs) is loaded
# by _do_t1_login, the only code that uses it, not here. Loading it at compile
# time made the whole daemon refuse to start on a node where those modules are
# missing - an install from a copied tree rather than the .deb that Depends on
# them - taking every storage down, even ones that never use SCRAM. Loaded
# late, a missing module fails just the SCRAM login, with the module named,
# and never falls back to a weaker mechanism (see _authenticate).

# Paths are overridable so the daemon can be exercised by a test as an
# unprivileged user against a scratch directory. The systemd unit sets none of
# these, so a real install is unaffected.
my $RUN_DIR        = $ENV{TRUENAS_BROKER_RUNDIR} || '/run/truenas-plugin';
my $SOCKET_PATH    = "$RUN_DIR/broker.sock";
my $PIDFILE        = "$RUN_DIR/broker.pid";
my $LOG_FILE       = $ENV{TRUENAS_BROKER_LOG} || '/var/log/truenas-plugin-broker.log';
my $IDLE_REAP_SECS = 600;   # close WS conns idle longer than this
# Ceiling on any single upstream read. A TrueNAS that reboots, a fabric that
# blips, or a firewall that forgets the flow leaves this end of the TCP
# connection believing it is established: writes land in the kernel buffer and
# reads never return. Since requests are served inline, one such connection
# silently takes the whole daemon - and every TrueNAS storage on this node -
# out of service until someone restarts it by hand. Overridable for slow
# arrays via TRUENAS_BROKER_TIMEOUT.
my $UPSTREAM_TIMEOUT = $ENV{TRUENAS_BROKER_TIMEOUT} || 30;
# A typo in the unit file should not produce a deadline in the past, which
# would fail every request instantly and look like a total outage.
if ($UPSTREAM_TIMEOUT !~ /^\d+(?:\.\d+)?$/ || $UPSTREAM_TIMEOUT < 1) {
    warn "TRUENAS_BROKER_TIMEOUT is not a positive number; using 30\n";
    $UPSTREAM_TIMEOUT = 30;
}
# Ceiling on a client-declared budget, so one caller cannot hold the single
# accept thread for an arbitrary time. Requests are served inline, so this
# number is the worst case for every OTHER storage on the node as well: at 600,
# one caller that asked for a ten-minute timeout left every TrueNAS storage here
# unserved for ten minutes, and pvestatd - which polls on a far shorter timer -
# stacked up behind it instead of failing cleanly. 90 is above any operation
# this plugin issues in practice and below the point where waiting is worse than
# reporting a failure. Raising it raises the blast radius, not just the patience.
my $MAX_BUDGET = $ENV{TRUENAS_BROKER_MAX_BUDGET} || 90;
if ($MAX_BUDGET !~ /^\d+(?:\.\d+)?$/ || $MAX_BUDGET < 5) {
    warn "TRUENAS_BROKER_MAX_BUDGET is not a number >= 5; using 90\n";
    $MAX_BUDGET = 90;
}
# Smallest upstream budget worth spending. The refusal below is for a client that
# is all but gone (under about 0.3 s left, since the budget is half of what is
# left), not for a short-but-usable one: a 1 s deadline reaches this broker every
# time a call arrives at the end of tn_op_budget_s, and a LAN round trip is tens
# of milliseconds.
my $MIN_CLIENT_BUDGET = 0.15;
# The liveness probe on a pooled connection gets a much shorter budget: its
# whole purpose is to find out quickly whether the socket is still real, and a
# probe that waits the full timeout defeats the point of probing.
my $PING_TIMEOUT = 5;
# How long a connected client gets to finish sending its request line. A local
# client has the whole thing in hand before it connects, so this only ever
# expires on a client that has stopped, and it must expire: an unbounded read
# here wedges the accept loop exactly as an unbounded upstream read did.
my $CLIENT_READ_TIMEOUT = 10;
# And a ceiling on how much we will buffer before giving up on finding the
# newline, so a peer that never sends one cannot grow us out of memory.
my $MAX_REQUEST_BYTES = 4 * 1024 * 1024;
# And the same on the way in from the upstream, for the same reason.
my $MAX_FRAME_BYTES = 64 * 1024 * 1024;
my $WS_PATH = '/api/current';

# Cache the pool-entry liveness probe (`auth.me`) result for up to
# this many seconds. Every plugin call goes through get_or_open_ws();
# running an auth-required RPC on every call adds a per-call round
# trip whose per-call cost is small in isolation but compounds under
# multi-node load, and 'auth.me' in particular returns a large
# response (full user + role list, several KiB) that TN's middleware
# serialises around user-record locks -- enough to trip 596 API
# timeouts in PVE under a busy 3-node test suite. Caching the last
# successful probe timestamp per pool entry and skipping the probe
# when it is <LIVENESS_CACHE_SECS old costs essentially nothing on
# healthy connections and still detects TrueNAS's 30-day silent
# session expiry (AA_LEVEL1.max_session_age, issue #98) within one
# cache window. Round-trip cost drops from "every call" to "at most
# one per LIVENESS_CACHE_SECS per pool entry".
my $LIVENESS_CACHE_SECS = 60;

# Prefork worker count. Each worker holds one upstream WS (auth'd once) and
# accepts on the shared listen fd; the kernel load-balances accept() across
# them. Under 3-node cluster test load a single-threaded broker serialized
# every RPC through one WS, so 4 concurrent client calls (extent.query x2,
# targetextent.query, pool.dataset.query) took 9.8 s wall vs 0.14+1.6+3.2+
# 9.8 ≈ 15 s serial-sum -- close to fully serialized. With N workers each
# client call parallelizes up to N-way. TN's rate-limit on
# auth.login_with_api_key is 20 / 60 s / IP; N=4 auths at broker startup
# stay well under that (and each worker only re-auths on WS disconnect).
# Bump this if a node has many pvedaemon workers; keep it small enough
# that startup burst + reconnect churn stays inside TN's 20/60s ceiling
# with headroom for other operational traffic.
my $PREFORK_N = $ENV{TRUENAS_BROKER_WORKERS} // 4;
if ($PREFORK_N !~ /^[1-4]$/) {
    warn "TRUENAS_BROKER_WORKERS must be between 1 and 4; using 4\n";
    $PREFORK_N = 4;
}

my $foreground = grep { $_ eq '--foreground' || $_ eq '-f' } @ARGV;
my $debug      = grep { $_ eq '--debug' || $_ eq '-d' } @ARGV;

# ---------------- logging ----------------
sub _log_line {
    my ($lvl, $msg) = @_;
    my $ts = strftime('%Y-%m-%dT%H:%M:%S', gmtime());
    my $line = "$ts $lvl $msg\n";
    if ($foreground) {
        print STDERR $line;
    } else {
        if (open(my $fh, '>>', $LOG_FILE)) {
            print $fh $line;
            close $fh;
        }
    }
}
# Same key list TrueNASPlugin.pm's own $TN_LOG_REDACT_KEYS uses - kept in
# sync by hand (this daemon runs standalone, independent of the plugin
# file, by design - see the wire-format note above), not because the two
# secrets pretend to be different. api_key alone (the previous version of
# this regex) missed password/dhchap_key/dhchap_ctrl_key - a malformed
# request line carrying any of those would have logged them in the clear
# (Kimi finding). Value pattern: any run of characters that are neither an
# unescaped quote nor a backslash, OR a backslash followed by one
# character (an escaped quote `\"` among them) - a naive `[^"]*` stops at
# the first escaped quote inside the value and leaves the remainder
# exposed.
my $REDACT_KEYS = qr/api_key|password|passwd|secret|token|dhchap_key|dhchap_ctrl_key/i;
my $JSON_STRING_VALUE = qr/(?:[^"\\]|\\.)*+/;

sub redact_raw_line {
    my ($text) = @_;
    return $text if !defined($text);
    $text =~ s/("(?:$REDACT_KEYS)"\s*:\s*)"$JSON_STRING_VALUE"/$1"<redacted>"/g;
    return $text;
}

sub linfo  { _log_line('INFO',  $_[0]); }
sub lwarn  { _log_line('WARN',  $_[0]); }
sub lerr   { _log_line('ERROR', $_[0]); }
sub ldebug { _log_line('DEBUG', $_[0]) if $debug; }

# ---------------- setup ----------------
sub ensure_rundir {
    my $dir = $RUN_DIR;
    mkdir($dir, 0700) unless -d $dir;
    chmod 0700, $dir;
}

sub daemonize {
    return if $foreground;
    defined(my $pid = fork()) or die "fork failed: $!";
    exit 0 if $pid;
    setsid() or die "setsid failed: $!";
    chdir('/') or die "chdir / failed: $!";
    open(STDIN,  '<', '/dev/null');
    open(STDOUT, '>>', '/dev/null');
    open(STDERR, '>>', $LOG_FILE) or open(STDERR, '>>', '/dev/null');
}

sub write_pidfile {
    open(my $fh, '>', $PIDFILE) or die "cannot write pidfile $PIDFILE: $!";
    print $fh "$$\n";
    close $fh;
}

# ---------------- WebSocket helpers (subset of plugin code) ----------------

# Resolve $host to an IPv4 literal so IO::Socket::INET/SSL cannot pick the
# AAAA record on a dual-stack TrueNAS when the caller asked for IPv4. Mirrors
# TrueNASPlugin.pm::_host_ipv4. Returns $host unchanged when it is already an
# IPv4 literal, when the lookup fails, or when the host is an IPv6 literal.
#
# Do not call Socket::gethostbyname: on Perl 5.40 / Debian Trixie (PVE 9)
# that name is gone from the Socket package and the call dies via
# Socket::AUTOLOAD, which made FQDN api_host unusable with prefer_ipv4=1.
sub _host_ipv4 {
    my ($host) = @_;
    return $host if !defined $host || $host eq '';
    return $1 if $host =~ /^(\d+\.\d+\.\d+\.\d+)$/;
    return $host if $host =~ /:/; # IPv6 literal

    my @ips;
    eval {
        my ($err, @res) = getaddrinfo($host, '', {
            family   => AF_INET,
            socktype => SOCK_STREAM,
        });
        return if $err || !@res;
        for my $ai (@res) {
            my ($nerr, $ip) = getnameinfo($ai->{addr}, NI_NUMERICHOST, NIx_NOSERV);
            next if $nerr;
            push @ips, $1 if defined($ip) && $ip =~ /^(\d+\.\d+\.\d+\.\d+)$/;
        }
    };
    if (!@ips) {
        my @ent = eval { CORE::gethostbyname($host) };
        if (@ent && defined $ent[4]) {
            my $ip = eval { inet_ntoa($ent[4]) };
            push @ips, $1 if defined($ip) && $ip =~ /^(\d+\.\d+\.\d+\.\d+)$/;
        }
    }
    return $ips[0] if @ips;
    return $host;
}

sub ws_open {
    my ($scfg, $deadline) = @_;
    $deadline //= time() + $UPSTREAM_TIMEOUT;
    # Normalize scheme the same way TrueNASPlugin.pm::_ws_defaults does.
    # Without this, an operator who set tn_api_scheme=https (rejected by the
    # plugin's own validator only against the direct-WS path) would slip
    # through the broker envelope raw, and the eq 'wss' check below would
    # miss — the broker would open plain TCP and the handshake would 400.
    my $scheme = $scfg->{api_scheme} || 'wss';
    if    ($scheme =~ /^https$/i) { $scheme = 'wss'; }
    elsif ($scheme =~ /^http$/i)  { $scheme = 'ws';  }
    my $host   = $scfg->{api_host} or die "ws_open: no api_host";
    my $port   = $scfg->{api_port} // (($scheme eq 'wss') ? 443 : 80);
    # Honor prefer_ipv4 (default 1). The wire schema always listed this field
    # but the earlier broker ignored it, so the OS resolver could pick AAAA
    # on a dual-stack TN even though the plugin had resolved A already.
    my $peer   = (($scfg->{prefer_ipv4} // 1) ? _host_ipv4($host) : $host);

    my $connect_timeout = $deadline - time();
    die "upstream connect deadline expired" if $connect_timeout <= 0;
    $connect_timeout = 15 if $connect_timeout > 15;
    my $sock;
    if ($scheme eq 'wss') {
        $sock = IO::Socket::SSL->new(
            PeerHost => $peer, PeerPort => $port,
            SSL_verify_mode => $scfg->{api_insecure} ? 0x00 : 0x02,
            SSL_hostname    => $host,
            Timeout => $connect_timeout,
        ) or die "TLS connect to $host:$port failed: $SSL_ERROR";
    } else {
        $sock = IO::Socket::INET->new(
            PeerHost => $peer, PeerPort => $port, Proto => 'tcp', Timeout => $connect_timeout,
        ) or die "TCP connect to $host:$port failed: $!";
    }

    # Keepalive so the kernel eventually tears down a peer that went away
    # without a FIN. The read deadline above already stops us waiting on such a
    # socket; this stops us handing a corpse back out of the pool as if it were
    # live. Best-effort: the constants are Linux-specific and the daemon must
    # still work if they are missing.
    # setsockopt returns false on failure rather than dying, so an earlier
    # eval{...1} here could never have detected anything; check the returns.
    # Partial failure matters: SO_KEEPALIVE alone, without the three intervals,
    # leaves the system default of two hours - keepalive in name only.
    for my $opt (
        [ 'SO_KEEPALIVE',   SOL_SOCKET,  SO_KEEPALIVE, 1  ],
        [ 'TCP_KEEPIDLE',   IPPROTO_TCP, 4,            30 ],
        [ 'TCP_KEEPINTVL',  IPPROTO_TCP, 5,            10 ],
        [ 'TCP_KEEPCNT',    IPPROTO_TCP, 6,            3  ],
    ) {
        my ($name, $level, $optname, $value) = @$opt;
        ldebug("could not set $name on the upstream socket: $!")
            unless setsockopt($sock, $level, $optname, pack('l', $value));
    }

    # Kernel-level backstop on both directions. The select-based deadlines
    # above cover the cases they can see, but on TLS they cannot see all of
    # them: select fires on ciphertext, and SSL_read then needs a whole record,
    # so a connection cut in the middle of a record can still block inside a
    # single sysread. SO_RCVTIMEO/SO_SNDTIMEO bound that in the kernel
    # regardless of what the SSL layer is doing. Set slightly above the
    # request budget so the ordinary deadline logic, which gives far better
    # diagnostics, is what normally fires.
    my $backstop = pack('l!l!', $UPSTREAM_TIMEOUT + 5, 0);
    ldebug("could not set SO_RCVTIMEO on the upstream socket: $!")
        unless setsockopt($sock, SOL_SOCKET, SO_RCVTIMEO, $backstop);
    ldebug("could not set SO_SNDTIMEO on the upstream socket: $!")
        unless setsockopt($sock, SOL_SOCKET, SO_SNDTIMEO, $backstop);

    my $key_raw = join '', map { chr(int(rand(256))) } 1..16;
    my $key_b64 = encode_base64($key_raw, '');
    my $req =
      "GET $WS_PATH HTTP/1.1\r\n".
      "Host: $host:$port\r\n".
      "Upgrade: websocket\r\n".
      "Connection: Upgrade\r\n".
      "Sec-WebSocket-Key: $key_b64\r\n".
      "Sec-WebSocket-Version: 13\r\n".
      "\r\n";
    print $sock $req;
    # Bounded like every other read here: a peer that completes the TCP
    # handshake and then never sends the 101 would otherwise hold the daemon
    # for good, and this path runs with no pooled connection to fall back on.
    my $resp = '';
    while (1) {
        die "WS handshake timed out waiting for the HTTP response"
            unless ws_wait_readable($sock, $deadline);
        my $got = $sock->sysread(my $buf, 1024);
        last unless defined $got && $got > 0;
        $resp .= $buf;
        last if $resp =~ /\r\n\r\n/s;
    }
    die "WS handshake failed: no HTTP 101 response" if $resp !~ m#^HTTP/1\.([01]) 101#;
    my ($accept) = $resp =~ /Sec-WebSocket-Accept:\s*(\S+)/i;
    my $expect = encode_base64(sha1($key_b64 . '258EAFA5-E914-47DA-95CA-C5AB0DC85B11'), '');
    die "WS handshake invalid accept key" if ($accept // '') ne $expect;

    my $conn = { sock => $sock, next_id => 1 };
    _authenticate($conn, $scfg, $deadline);
    return $conn;
}

# Probe auth.mechanism_choices, pick a tier, and log in. Probe failures are
# classified by _select_mechanism (pure); this sub does the I/O. Every round
# trip of every tier runs against the one absolute $deadline ws_open was given
# (the request's own), so a multi-step SCRAM login cannot outlive the request.
sub _authenticate {
    my ($conn, $scfg, $deadline) = @_;
    my $username = $scfg->{api_username};
    $username = undef if defined $username && !length $username;
    my $mech = $scfg->{auth_mechanism} || 'auto';
    my $api_key = $scfg->{api_key};

    my ($probe_result, $probe_err);
    if (defined $username) {
        my $resp = eval {
            ws_rpc($conn, {
                jsonrpc => "2.0", id => $conn->{next_id}++,
                method  => "auth.mechanism_choices", params => [],
            }, $deadline);
        };
        if ($@) { $probe_err = "$@"; }
        elsif (ref($resp) eq 'HASH' && exists $resp->{error}) {
            $probe_err = encode_json($resp->{error});
        } elsif (ref($resp) eq 'HASH' && ref($resp->{result}) eq 'ARRAY') {
            $probe_result = $resp->{result};
        } elsif (ref($resp) eq 'ARRAY') {
            $probe_result = $resp;
        } else {
            $probe_err = "auth.mechanism_choices: no usable response";
        }
    }

    my $cb_raw;
    if ($mech eq 'scram-plus') {
        my ($cb, $cb_err) = _extract_tls_server_end_point($conn->{sock});
        die "[TrueNAS] tn_auth_mechanism=scram-plus: TLS peer certificate not available for channel binding: $cb_err\n"
            unless defined $cb;
        $cb_raw = $cb;
    }

    my $tier = _select_mechanism($username, $mech, $probe_result, $probe_err, defined $cb_raw ? 1 : 0);
    linfo("auth: using tier $tier (mechanism=$mech)");
    if ($tier eq 'T1') {
        return 1 if eval { _do_t1_login($conn, $username, $api_key, deadline => $deadline); 1 };
        my $err = $@;
        # Only auto mode may fall back, and only when the server rejected
        # SCRAM itself; any other T1 failure is fatal (no fail-open).
        my $unsupported = _is_scram_unsupported_error($err)
                          || $err =~ /SCRAM unsupported by server/;
        my $nomethod = _is_method_not_found($err);
        die $err if $mech ne 'auto' || !($unsupported || $nomethod);
        lwarn("auth: SCRAM unavailable on server, falling back to API_KEY_PLAIN");
        $tier = 'T2';
    }
    if ($tier eq 'T2') {
        return 1 if eval { _do_t2_login($conn, $username, $api_key, $deadline); 1 };
        my $err = $@;
        # Only a missing login_ex (pre-25.10 server) falls to the legacy
        # floor; AUTH_ERR, DENIED, rate-limit etc. stay fatal.
        die $err if $mech eq 'scram' || !_is_method_not_found($err);
        lwarn("auth: auth.login_ex not available, falling back to legacy API-key login");
    }
    if ($tier eq 'T1-PLUS') {
        _do_t1_login($conn, $username, $api_key, channel_binding => $cb_raw, deadline => $deadline);
        return 1;
    }
    return _do_t3_login($conn, $api_key, $deadline);
}

# --- RFC 5929 tls-server-end-point support --------------------------------

# Signature-algorithm OID (dotted) -> OpenSSL long name. Used because
# Net::SSLeay::X509_get_signature_nid is absent on bookworm.
my %SIG_OID_NAME = (
    '1.2.840.113549.1.1.4'  => 'md5WithRSAEncryption',
    '1.2.840.113549.1.1.5'  => 'sha1WithRSAEncryption',
    '1.2.840.113549.1.1.14' => 'sha224WithRSAEncryption',
    '1.2.840.113549.1.1.11' => 'sha256WithRSAEncryption',
    '1.2.840.113549.1.1.12' => 'sha384WithRSAEncryption',
    '1.2.840.113549.1.1.13' => 'sha512WithRSAEncryption',
    '1.2.840.113549.1.1.10' => 'rsassaPss',
    '1.2.840.10045.4.1'     => 'ecdsa-with-SHA1',
    '1.2.840.10045.4.3.1'   => 'ecdsa-with-SHA224',
    '1.2.840.10045.4.3.2'   => 'ecdsa-with-SHA256',
    '1.2.840.10045.4.3.3'   => 'ecdsa-with-SHA384',
    '1.2.840.10045.4.3.4'   => 'ecdsa-with-SHA512',
    '1.2.840.10040.4.3'     => 'dsaWithSHA1',
    '2.16.840.1.101.3.4.3.1' => 'dsa_with_SHA224',
    '2.16.840.1.101.3.4.3.2' => 'dsa_with_SHA256',
    '1.3.101.112'           => 'ED25519',
    '1.3.101.113'           => 'ED448',
);

# RFC 5929 section 4.1: hash of the cert's signature algorithm; MD5/SHA-1
# become SHA-256. undef = unsupported/unknown (caller must refuse).
sub _cb_digest_for_sig_alg {
    my ($sig) = @_;
    return undef unless defined $sig && length $sig;
    return 'sha256' if $sig =~ /^(?:md5|sha1)WithRSA/i
                    || $sig =~ /^(?:ecdsa-with-SHA1|dsaWithSHA1|RSA-SHA1|RSA-MD5)$/i;
    return 'sha224' if $sig =~ /sha-?224/i;
    return 'sha256' if $sig =~ /sha-?256/i;
    return 'sha384' if $sig =~ /sha-?384/i;
    return 'sha512' if $sig =~ /sha-?512/i;
    return undef;
}

# Read the signatureAlgorithm OID out of a DER X.509 and return its
# OpenSSL name (or dotted OID if not in the table); undef on parse failure.
sub _sig_alg_name_from_der {
    my ($der) = @_;
    return undef unless defined $der && length $der;
    my $pos = 0;
    my $hdr = sub {    # -> (tag, header_len, content_len) at $pos
        return () if $pos + 2 > length $der;
        my ($t, $l) = unpack('CC', substr($der, $pos, 2));
        my $n = 2;
        if ($l & 0x80) {
            my $k = $l & 0x7f;
            return () if $k < 1 || $k > 4 || $pos + 2 + $k > length $der;
            $l = 0; $l = ($l << 8) | $_ for unpack('C*', substr($der, $pos + 2, $k));
            $n += $k;
        }
        return ($t, $n, $l);
    };
    my ($t, $n, $l) = $hdr->();
    return undef unless defined $t && $t == 0x30;
    $pos += $n;                                   # into Certificate
    ($t, $n, $l) = $hdr->();
    return undef unless defined $t && $t == 0x30;
    $pos += $n + $l;                              # skip tbsCertificate
    ($t, $n, $l) = $hdr->();
    return undef unless defined $t && $t == 0x30;
    $pos += $n;                                   # into AlgorithmIdentifier
    ($t, $n, $l) = $hdr->();
    return undef unless defined $t && $t == 0x06 && $l > 0
                     && $pos + $n + $l <= length $der;
    my @b = unpack('C*', substr($der, $pos + $n, $l));
    my $first = shift @b;
    my @arc = (int($first / 40), $first % 40);
    my $v = 0;
    for my $b (@b) { $v = ($v << 7) | ($b & 0x7f); unless ($b & 0x80) { push @arc, $v; $v = 0 } }
    my $oid = join '.', @arc;
    return $SIG_OID_NAME{$oid} // $oid;
}

# Returns ($cb_raw, undef) or (undef, $err_text).
sub _extract_tls_server_end_point {
    my ($sock) = @_;
    my $x509 = eval { $sock->peer_certificate };
    return (undef, "no peer certificate") unless $x509;
    my $sig;
    my $nid = eval { Net::SSLeay::X509_get_signature_nid($x509) };
    if ($nid) {
        $sig = Net::SSLeay::OBJ_nid2ln($nid);
    } else {
        # See spec "What's left to the builder": DER-OID parse fallback
        # (X509_get_signature_nid is missing on bookworm; i2d_X509 too, so
        # take the DER from the PEM form).
        my $pem = eval { Net::SSLeay::PEM_get_string_X509($x509) };
        my $der;
        if (defined $pem && $pem =~ /-----BEGIN CERTIFICATE-----(.*?)-----END/s) {
            require MIME::Base64;
            $der = MIME::Base64::decode_base64($1);
        }
        $sig = _sig_alg_name_from_der($der);
    }
    my $hash = _cb_digest_for_sig_alg($sig);
    return (undef, "unsupported certificate signature algorithm: " . ($sig // 'unknown'))
        unless defined $hash;
    my $raw = eval { $sock->get_fingerprint_bin($hash) };
    return (undef, "could not compute $hash certificate fingerprint")
        unless defined $raw && length $raw;
    return ($raw, undef);
}

# True when the server reported a missing JSON-RPC method. Narrow on
# purpose: generic "not found" text does not count.
sub _is_method_not_found {
    my ($err) = @_;
    return 0 unless defined $err;
    return 1 if $err =~ /Method\s+'[^']+'\s+not found/i;
    return 1 if $err =~ /method not found/i;
    return 1 if $err =~ /unknown method/i;
    return 0;
}

# Pure tier selector. T1=SCRAM, T1-PLUS=SCRAM with channel binding,
# T2=API_KEY_PLAIN login_ex, T3=legacy login_with_api_key. Probe errors are classified here: an "unavailable"
# error is checked BEFORE rate-limit, because the unsupported envelope can
# carry a code that _is_rate_limited also matches.
# The fifth arg, $cb_available, is a boolean the caller sets after
# extracting the TLS peer-cert digest. In the current tree it is not
# consumed by any branch (scram-plus's CB readiness is checked in the
# caller before dispatch, which Task 4 adds). The arg exists so a later
# extension can read it without changing the signature again.
sub _select_mechanism {
    my ($username, $mech, $probe_result, $probe_err, $cb_available) = @_;
    $mech = 'auto' unless defined $mech && length $mech;
    $username = undef if defined $username && !length $username;

    my $limited = 0;
    if (defined $probe_err) {
        my $unsupported = _is_scram_unsupported_error($probe_err)
                          || _is_method_not_found($probe_err);
        $limited = 1 if !$unsupported && _is_rate_limited($probe_err);
    }
    my %have = map { $_ => 1 } (ref($probe_result) eq 'ARRAY' ? @$probe_result : ());

    if ($mech eq 'scram') {
        die "tn_auth_mechanism=scram requires tn_api_username\n" unless defined $username;
        return 'T1' if $have{SCRAM} || $limited;
        die "tn_auth_mechanism=scram but server does not support SCRAM\n";
    }
    if ($mech eq 'plain') {
        return 'T3' unless defined $username;
        return 'T2' if ref($probe_result) eq 'ARRAY' || $limited;
        return 'T3';
    }
    if ($mech eq 'scram-plus') {
        die "tn_auth_mechanism=scram-plus requires tn_api_username\n" unless defined $username;
        return 'T1-PLUS' if $have{SCRAM} || $limited;
        die "tn_auth_mechanism=scram-plus but server does not advertise SCRAM\n";
    }
    die "tn_auth_mechanism=$mech: unknown mechanism\n" unless $mech eq 'auto';
    return 'T3' unless defined $username;
    return 'T1' if $have{SCRAM};
    return 'T2' if $have{API_KEY_PLAIN};
    return 'T1' if $limited;
    return 'T3';
}

# Legacy (T3) login: one auth.login_with_api_key call. Dies "no response
# from TrueNAS during authentication" when there is no response (this fork's
# wording, kept over upstream's "TrueNAS authentication failed": see below),
# dies "legacy API-key login rejected" on a false result, and dies with the
# serialized JSON-RPC error on an error envelope so _is_rate_limited can
# classify it. Accepts either the full JSON-RPC envelope (what ws_rpc
# returns) or a bare boolean.
# Silence and rejection are different faults and want different responses:
# one is the network, the other is the API key. Reporting a timed-out read
# as "authentication failed" sent the reader to check credentials while the
# real problem was a TrueNAS that had stopped answering, so the no-response
# message never says "authentication failed" (t/broker/01). A rate-limit lockout on this very method is
# the daemon's signature failure - the whole reason it exists - so it is
# named as such instead of reading like a rejected key.
# $deadline (absolute, optional) is the request's own, as everywhere in the
# authentication path: see ws_rpc.
sub _do_t3_login {
    my ($conn, $api_key, $deadline) = @_;
    my $auth = ws_rpc($conn, {
        jsonrpc => "2.0", id => $conn->{next_id}++,
        method  => "auth.login_with_api_key",
        params  => [ $api_key ],
    }, $deadline);
    die "no response from TrueNAS during authentication (timed out or "
      . "connection lost)\n"
        unless defined $auth;
    my $result = $auth;
    if (ref($auth) eq 'HASH') {
        if (exists $auth->{error}) {
            my $e = ref($auth->{error}) ? encode_json($auth->{error}) : $auth->{error};
            die "TrueNAS is rate-limiting authentication; wait for the lockout "
              . "to expire: legacy API-key login error: $e\n"
                if _is_rate_limited($e) || $e =~ /rate.?limit|too many|throttl/i;
            die "legacy API-key login error: $e\n";
        }
        $result = $auth->{result};
    }
    die "legacy API-key login rejected\n" unless $result;
    return 1;
}

# T2 login: auth.login_ex with mechanism API_KEY_PLAIN (TN 25.10+). Only
# response_type SUCCESS counts as authenticated; anything else dies naming
# the mechanism and the server's response_type. ws_rpc errors propagate so
# the caller can classify "server lacks login_ex" from the error text.
sub _do_t2_login {
    my ($conn, $username, $api_key, $deadline) = @_;
    my $resp = ws_rpc($conn, {
        jsonrpc => "2.0", id => $conn->{next_id}++,
        method  => "auth.login_ex",
        params  => [{
            mechanism     => "API_KEY_PLAIN",
            username      => $username,
            api_key       => $api_key,
            login_options => {},
        }],
    }, $deadline);
    die "[TrueNAS] API_KEY_PLAIN login failed: no response from server\n"
        unless defined $resp;
    # ws_rpc returns the whole JSON-RPC envelope and does not die on server
    # errors; handle the error envelope explicitly so the server's detail
    # (code/message) reaches the caller for classification.
    if (ref($resp) eq 'HASH' && exists $resp->{error}) {
        die "[TrueNAS] API_KEY_PLAIN login error: " . encode_json($resp->{error}) . "\n";
    }
    my $res = (ref($resp) eq 'HASH' && ref($resp->{result}) eq 'HASH')
        ? $resp->{result} : $resp;
    my $rt = ref($res) eq 'HASH' ? $res->{response_type} : undef;
    $rt = 'UNKNOWN' unless defined $rt && length $rt;
    die "[TrueNAS] API_KEY_PLAIN login rejected: $rt\n" unless $rt eq 'SUCCESS';
    return 1;
}

# True when the server rejected the SCRAM mechanism (TN 25.10 lacks it).
sub _is_scram_unsupported_error {
    my ($err) = @_;
    return 0 unless defined $err;
    return $err =~ /Input tag 'SCRAM'.*does not match/s ? 1 : 0;
}

# One SCRAM auth.login_ex round trip. Returns the unwrapped result hash;
# dies "SCRAM unsupported by server" (classifiable by the caller) or
# "SCRAM auth failed" on any problem. Non-SCRAM ws_rpc failures propagate.
sub _scram_step {
    my ($conn, $scram_type, $rfc_str, $want_type, $deadline) = @_;
    my $resp = eval {
        ws_rpc($conn, {
            jsonrpc => "2.0", id => $conn->{next_id}++,
            method  => "auth.login_ex",
            params  => [{ mechanism => "SCRAM", scram_type => $scram_type,
                          rfc_str => $rfc_str }],
        }, $deadline);
    };
    if (my $err = $@) {
        die "[TrueNAS] SCRAM unsupported by server: $err"
            if _is_scram_unsupported_error($err);
        die $err;
    }
    die "[TrueNAS] SCRAM auth failed: no response from server\n"
        unless defined $resp;
    if (ref($resp) eq 'HASH' && exists $resp->{error}) {
        my $msg = ref($resp->{error}) eq 'HASH' ? ($resp->{error}{message} // "") : "";
        die "[TrueNAS] SCRAM unsupported by server: " . encode_json($resp->{error}) . "\n"
            if _is_scram_unsupported_error($msg);
        die "[TrueNAS] SCRAM auth failed: " . encode_json($resp->{error}) . "\n";
    }
    my $res = (ref($resp) eq 'HASH' && ref($resp->{result}) eq 'HASH')
        ? $resp->{result} : $resp;
    unless (ref($res) eq 'HASH'
            && ($res->{response_type} // '') eq 'SCRAM_RESPONSE'
            && ($res->{scram_type} // '') eq $want_type) {
        die "[TrueNAS] SCRAM auth failed: unexpected response: "
            . encode_json(ref($res) ? $res : { raw => $res }) . "\n";
    }
    return $res;
}

# T1 login: SCRAM-SHA-512 over auth.login_ex. The secret never goes on the
# wire; the server's signature is verified before success is returned.
sub _do_t1_login {
    my ($conn, $username, $api_key, %opts) = @_;
    require TrueNAS::SCRAM;
    TrueNAS::SCRAM->import(qw(scram_split_api_key scram_client_first scram_process_server_first
                              scram_client_final scram_verify_server_final));
    my ($key_id, $secret) = scram_split_api_key($api_key);
    my ($state, $first_wire) = scram_client_first($username, $key_id,
        (defined $opts{channel_binding} ? (channel_binding => $opts{channel_binding}) : ()));

    my $r1 = _scram_step($conn, "CLIENT_FIRST_MESSAGE", $first_wire, "SERVER_FIRST_RESPONSE", $opts{deadline});
    scram_process_server_first($state, $r1->{rfc_str}, $secret);
    my $final_wire = scram_client_final($state);

    my $r2 = _scram_step($conn, "CLIENT_FINAL_MESSAGE", $final_wire, "SERVER_FINAL_RESPONSE", $opts{deadline});
    eval { scram_verify_server_final($state, $r2->{rfc_str}); 1 }
        or do { my $m = $@; $m =~ s/^scram:\s*//; die "[TrueNAS] SCRAM auth failed: $m"; };

    $state->{saltedPassword} = "\0" x length($state->{saltedPassword} // '');
    $secret = "\0" x length($secret);
    return 1;
}

# True when an error string looks like TrueNAS's auth rate limiter, matching
# the terraform provider's heuristic: APIError code 0/16/22/-32000, or the
# message contains "rate limit" / "concurrent calls" (case-insensitive).
sub _is_rate_limited {
    my ($err) = @_;
    return 0 unless defined $err && length $err;
    return 1 if $err =~ /"code"\s*:\s*(?:0|16|22|-32000)\b/;
    return 1 if $err =~ /\bcode\s*[:=]?\s*(?:0|16|22|-32000)\b/i;
    my $l = lc $err;
    return 1 if index($l, 'rate limit') >= 0 || index($l, 'concurrent calls') >= 0;
    return 0;
}

sub xor_mask {
    my ($data, $mask) = @_;
    my $out = $data;
    my $len = length($data);
    for (my $i = 0; $i < $len; $i++) {
        substr($out, $i, 1) = chr(ord(substr($data, $i, 1)) ^ ord(substr($mask, $i % 4, 1)));
    }
    return $out;
}

# Wait until $sock has something to read, or the deadline passes. Returns 1 if
# readable, 0 on timeout. IO::Socket::SSL decodes a whole TLS record at a time,
# so bytes can already be sitting in its buffer with nothing left on the wire -
# select() would then block on a socket whose data has in fact arrived. Ask the
# SSL layer first and only fall through to select() when it holds nothing.
sub ws_wait_readable {
    my ($sock, $deadline) = @_;
    return 1 if $sock->can('pending') && $sock->pending();
    my $remaining = $deadline - time();
    return 0 if $remaining <= 0;
    my $sel = IO::Select->new($sock);
    return $sel->can_read($remaining) ? 1 : 0;
}

# Write the whole buffer, bounded by an absolute deadline. Returns 1 on
# success, 0 on timeout or error.
#
# syswrite is under no obligation to take everything, and on TLS it does not:
# measured on IO::Socket::SSL 2.085, one call caps at a single TLS record -
# 8 KB and 16 KB went out whole, 64 KB and 256 KB both returned 16384. The
# daemon used to call syswrite once and discard what it returned, so any frame
# past that size went out truncated and the far end sat waiting for the rest of
# a frame that was never coming; the request then died on its own deadline
# reporting "no response", with the real cause invisible. Plain Unix sockets
# short-write the same way once the reader stops draining, which is the same
# story on the reply path.
sub write_all {
    my ($sock, $data, $deadline) = @_;
    $deadline //= time() + $UPSTREAM_TIMEOUT;
    my $len = length($data);
    my $off = 0;
    while ($off < $len) {
        my $remaining = $deadline - time();
        if ($remaining <= 0) {
            lwarn("write timed out with " . ($len - $off) . " of $len byte(s) unsent");
            return 0;
        }
        my $sel = IO::Select->new($sock);
        unless ($sel->can_write($remaining)) {
            lwarn("write timed out with " . ($len - $off) . " of $len byte(s) unsent");
            return 0;
        }
        my $n = $sock->syswrite(substr($data, $off));
        if (!defined $n) {
            next if $!{EAGAIN} || $!{EWOULDBLOCK} || $!{EINTR};
            lwarn("write failed after $off of $len byte(s): $!");
            return 0;
        }
        last if $n == 0;
        $off += $n;
    }
    return $off == $len ? 1 : 0;
}

# Read exactly $len bytes, bounded by an absolute deadline.
#
# The deadline covers the whole read rather than each sysread, so a slow but
# advancing transfer is not cut off - the same envelope the plugin applies to
# its own end of the Unix socket. Without it, a peer that accepts the connection
# and then says nothing blocks here forever: the constructor's Timeout only ever
# covered connect(). And because this daemon serves clients inline, one such
# block is not a single stalled request, it is every request that follows.
sub ws_read_exact {
    my ($sock, $bufref, $len, $deadline) = @_;
    $$bufref = '';
    $deadline //= time() + $UPSTREAM_TIMEOUT;
    while (length($$bufref) < $len) {
        unless (ws_wait_readable($sock, $deadline)) {
            # Deliberately does not name a number of seconds. The probe and a
            # full call run on different budgets, and an earlier draft of this
            # line printed the global default for both - which would have sent
            # the reader hunting for a 30 s stall that was really a 5 s one.
            lwarn("upstream read timed out waiting for "
                . ($len - length($$bufref)) . " more byte(s)");
            return 0;
        }
        my $got = $sock->sysread(my $tmp, $len - length($$bufref));
        return 0 unless defined $got && $got > 0;
        $$bufref .= $tmp;
    }
    return 1;
}

# Frame and send one masked client-to-server frame. RFC 6455 requires every
# frame a client sends to be masked and obliges the server to fail the
# connection on an unmasked one, so this is used for control frames too.
sub ws_send_frame {
    my ($sock, $opcode, $payload, $deadline) = @_;
    $payload //= '';
    my $len = length($payload);
    my $mask_key = join '', map { chr(int(rand(256))) } 1..4;
    my $hdr = pack('C', 0x80 | $opcode);   # FIN=1
    my $masked_flag = 0x80;
    if    ($len <= 125)       { $hdr .= pack('C',   $masked_flag | $len); }
    elsif ($len <= 0xFFFF)    { $hdr .= pack('C n', $masked_flag | 126, $len); }
    else                      { $hdr .= pack('C Q>',$masked_flag | 127, $len); }
    return write_all($sock, $hdr . $mask_key . xor_mask($payload, $mask_key), $deadline);
}

sub ws_send_text {
    my ($sock, $text, $deadline) = @_;
    return ws_send_frame($sock, 0x1, $text, $deadline);
}

sub ws_recv_text {
    my ($sock, $deadline) = @_;
    $deadline //= time() + $UPSTREAM_TIMEOUT;
    my $message = '';
    while (1) {
        my $hdr;
        return undef unless ws_read_exact($sock, \$hdr, 2, $deadline);
        my ($b1, $b2) = unpack('CC', $hdr);
        my $fin    = $b1 & 0x80;
        my $opcode = $b1 & 0x0F;
        my $masked = $b2 & 0x80;
        my $len    = $b2 & 0x7F;
        if ($len == 126) {
            my $ext; return undef unless ws_read_exact($sock, \$ext, 2, $deadline);
            $len = unpack('n', $ext);
        } elsif ($len == 127) {
            my $ext; return undef unless ws_read_exact($sock, \$ext, 8, $deadline);
            $len = unpack('Q>', $ext);
        }
        # A declared length is not a promise. Now that a read can time out
        # part-way through a payload, the stream can resume mis-aligned and a
        # byte of JSON gets parsed as a frame header - and sysread pre-grows
        # its target to the length asked for, so a bogus 64-bit value is an
        # immediate out-of-memory abort. The unit sets no MemoryMax, so the
        # kernel would then pick the largest process on the node to kill, which
        # on a hypervisor is somebody's VM.
        if ($len > $MAX_FRAME_BYTES) {
            lwarn("upstream frame claims $len bytes, over the $MAX_FRAME_BYTES limit; dropping the connection");
            return undef;
        }
        my $mask_key = '';
        if ($masked) {
            return undef unless ws_read_exact($sock, \$mask_key, 4, $deadline);
        }
        my $payload = '';
        if ($len > 0) {
            return undef unless ws_read_exact($sock, \$payload, $len, $deadline);
            $payload = xor_mask($payload, $mask_key) if $masked;
        }
        if    ($opcode == 0x01) { $message  = $payload; return $message if $fin; }
        elsif ($opcode == 0x00) { $message .= $payload; return $message if $fin; }
        elsif ($opcode == 0x08) { return undef; }            # close
        elsif ($opcode == 0x09) {                            # ping
            # Masked, like every other frame we send. The hand-rolled pong this
            # replaces was unmasked, which RFC 6455 requires the server to
            # answer by failing the connection - and a dropped session here
            # means a fresh login, which is the rate-limit spiral this daemon
            # exists to avoid.
            ws_send_frame($sock, 0xA, $payload, $deadline);
        }
        elsif ($opcode == 0x0A) { }                          # pong
        else { return undef; }
    }
}

sub ws_rpc {
    # $deadline is absolute, and is the caller's to set. Taking a relative
    # timeout here instead let each step start its own clock: a probe that
    # spent 5 s followed by a reconnect that spent 30 s produced a 35 s
    # request - longer than the deadline the plugin gives the whole round
    # trip, so the client gave up first and the work was wasted.
    my ($conn, $obj, $deadline) = @_;
    $deadline //= time() + $UPSTREAM_TIMEOUT;
    my $req_id = $obj->{id};
    my $text = encode_json($obj);
    ws_send_text($conn->{sock}, $text, $deadline)
        or die "could not send the request upstream (timed out or connection lost)";
    my $max_skip = 10;
    for (my $skipped = 0; $skipped <= $max_skip; $skipped++) {
        my $resp = ws_recv_text($conn->{sock}, $deadline);
        return undef unless defined $resp;
        my $decoded = eval { decode_json($resp) };
        next if $@ || !$decoded;
        if (defined($req_id) && ref($decoded) eq 'HASH'
            && defined($decoded->{id}) && "$decoded->{id}" eq "$req_id")
        {
            return $decoded;
        }
    }
    return undef;
}

# ---------------- per-(host,key) connection pool ----------------
my %POOL;       # scfg_key -> { conn => $ws_conn, last_used => $epoch }

sub scfg_key {
    my ($scfg) = @_;
    my $host = $scfg->{api_host} // '';
    my $key  = $scfg->{api_key}  // '';
    my $user = $scfg->{api_username} // '';
    my $mech = $scfg->{auth_mechanism} || 'auto';
    # Don't put raw api_key in memory key; hash it with username+mechanism so
    # two storages on one host with different identities get separate pools.
    return $host . ':' . sha1_hex($key . '|' . $user . '|' . $mech);
}

# A liveness answer counts only if it is an envelope that carries a result and
# no error. ws_rpc hands back the whole decoded envelope, so an
# ENOTAUTHENTICATED reply is a truthy hash too.
sub liveness_ok {
    my ($resp) = @_;
    return 0 if ref($resp) ne 'HASH';
    return 0 if defined $resp->{error};
    return defined $resp->{result} ? 1 : 0;
}

sub get_or_open_ws {
    my ($scfg, $deadline) = @_;
    $deadline //= time() + $UPSTREAM_TIMEOUT;
    my $sk = scfg_key($scfg);
    my $entry = $POOL{$sk};
    if ($entry && $entry->{conn} && $entry->{conn}->{sock}) {
        # Liveness check: call an AUTHENTICATED method to detect TrueNAS's
        # silent 30-day session expiry (AA_LEVEL1.max_session_age); 'core.ping'
        # is no_auth_required and cannot. 'auth.me' fits but its response is
        # large and TN serialises around user-record locks, so the last
        # successful probe is cached per pool entry and a fresh one is skipped
        # (upstream issue #98: the uncached probe caused 596 PVE-API timeouts
        # under multi-node load). Expiry is still caught within
        # LIVENESS_CACHE_SECS of the next call.
        my $now = time();
        my $last_ok = $entry->{last_liveness_ok} // 0;
        if ($now - $last_ok < $LIVENESS_CACHE_SECS) {
            $entry->{last_used} = $now;
            return $entry->{conn};
        }
        # The probe gets a tight budget of its own - this is the read most
        # likely to meet a half-open socket, because a pooled connection is by
        # definition one nobody has touched recently - but never more than the
        # request as a whole has left, so a failed probe still leaves room to
        # reconnect inside the same deadline.
        my $ping_deadline = $now + $PING_TIMEOUT;
        $ping_deadline = $deadline if $ping_deadline > $deadline;
        my $ok = eval {
            ws_rpc($entry->{conn}, {
                jsonrpc => "2.0", id => 999999, method => "auth.me", params => [],
            }, $ping_deadline);
        };
        if (liveness_ok($ok)) {
            $entry->{last_used} = $now;
            $entry->{last_liveness_ok} = $now;
            return $entry->{conn};
        }
        # Dead or unauthenticated; drop and reopen (which re-auths).
        eval { $entry->{conn}->{sock}->close(); };
        delete $POOL{$sk};
    }
    my $conn = ws_open($scfg, $deadline);
    my $now = time();
    # ws_open() just authenticated against TN, so the session is
    # authenticated as of `now`: stamp last_liveness_ok so the first calls
    # within LIVENESS_CACHE_SECS skip the auth.me probe.
    $POOL{$sk} = { conn => $conn, last_used => $now, last_liveness_ok => $now };
    linfo("opened WS for $sk (pool size " . scalar(keys %POOL) . ")");
    return $conn;
}

sub reap_idle {
    my $now = time();
    for my $sk (keys %POOL) {
        my $e = $POOL{$sk};
        next unless $e && $e->{conn};
        if ($now - $e->{last_used} > $IDLE_REAP_SECS) {
            linfo("reaping idle WS for $sk");
            eval { $e->{conn}->{sock}->close(); };
            delete $POOL{$sk};
        }
    }
}

# ---------------- systemd Type=notify integration ----------------
# When started under a systemd unit with Type=notify, systemd waits
# for READY=1 on NOTIFY_SOCKET before considering the service
# started. Downstream services (pvestatd, pvedaemon, pveproxy) with
# After=truenas-plugin-broker.service will then wait for the broker
# to actually be accepting connections — not just for the process
# to be alive, which is all Type=simple guarantees. See GitHub #132:
# at reboot, Type=simple let pvestatd start before the broker socket
# was listening, and each pvestatd fork fell back to direct-WS auth
# against TrueNAS, tripping TN's auth.login_with_api_key rate limit
# (20 / 60 s) and locking the whole startup chain out for the
# cooldown window. Type=notify + a READY=1 after bind closes that.
#
# Pure Perl implementation to avoid an extra process fork for a
# `systemd-notify --ready` child during startup.
sub sd_notify_ready {
    my $sock_path = $ENV{NOTIFY_SOCKET};
    return unless defined($sock_path) && length($sock_path);
    # Abstract-namespace socket: name begins with '@' in the env var
    # and should be sent to \0<rest> as the sun_path.
    my $raw_path = $sock_path;
    $raw_path = "\0" . substr($raw_path, 1) if substr($raw_path, 0, 1) eq '@';
    my $addr = eval { Socket::sockaddr_un($raw_path) };
    return unless defined $addr;
    socket(my $sock, Socket::PF_UNIX(), Socket::SOCK_DGRAM(), 0) or return;
    send($sock, "READY=1\n", 0, $addr);
    close($sock);
}

# ---------------- Unix-socket server ----------------
sub make_listener {
    unlink $SOCKET_PATH if -e $SOCKET_PATH;
    my $srv = IO::Socket::UNIX->new(
        Local  => $SOCKET_PATH,
        # Clients wait here while the single thread serves the one in flight,
        # and a client sitting in the backlog has not been accepted yet, so its
        # own read timeout has not started counting. A short queue turns one
        # slow request into refused connections for everybody else.
        Listen => 128,
        Type   => SOCK_STREAM,
    ) or die "cannot bind $SOCKET_PATH: $!";
    chmod 0600, $SOCKET_PATH;
    return $srv;
}

# Read one line (ending in \n) from a non-blocking-ish client. Returns
# undef on EOF/error, string (without trailing \n) on success.
# Read one newline-terminated request from a client, bounded.
#
# This was the last unbounded read in the daemon, and it wedged it just as
# thoroughly as the upstream one did: measured against the already-deadlined
# build, a local client that connected and then sent a request without its
# trailing newline left the accept loop stuck here, and a second, healthy
# client went unanswered for as long as it waited. A client that DIES is
# harmless - the socket reports EOF - but one that merely stops, because it is
# stopped, or blocked in D state on the very storage this daemon serves, does
# not. Returns undef on EOF, error, timeout, or an over-long request.
sub read_line_blocking {
    my ($fh, $deadline) = @_;
    $deadline //= time() + $CLIENT_READ_TIMEOUT;
    my $buf = '';
    while (1) {
        unless (ws_wait_readable($fh, $deadline)) {
            lwarn("client sent no complete request before its read deadline");
            return undef;
        }
        my $got = $fh->sysread(my $tmp, 4096);
        return undef unless defined $got && $got > 0;
        $buf .= $tmp;
        if ((my $idx = index($buf, "\n")) >= 0) {
            my $line = substr($buf, 0, $idx);
            return $line;
        }
        # A peer that never sends a newline would otherwise grow this buffer
        # until the daemon is killed for it.
        if (length($buf) > $MAX_REQUEST_BYTES) {
            lwarn("client request exceeded $MAX_REQUEST_BYTES bytes with no newline; dropping");
            return undef;
        }
    }
}

my $QUEUE_EXPIRED_COUNT = 0; # per worker; each expiry is also logged
sub handle_request {
    my ($client, $accepted_at) = @_;
    $accepted_at //= time();
    my $line = read_line_blocking($client, $accepted_at + $CLIENT_READ_TIMEOUT);
    return unless defined $line;
    my $req = eval { decode_json($line) };
    if ($@ || !$req) {
        lwarn("bad request JSON: $@");
        my $err = encode_json({ error => "broker: bad request JSON: $@" });
        write_all($client, "$err\n", time() + $CLIENT_READ_TIMEOUT);
        return;
    }
    my $scfg = $req->{scfg};
    if (!$scfg || !$scfg->{api_host} || !$scfg->{api_key}) {
        my $h    = ref($scfg) eq 'HASH' && defined $scfg->{api_host} ? $scfg->{api_host} : '<undef>';
        my $kraw = ref($scfg) eq 'HASH' ? $scfg->{api_key} : undef;
        my $k    = !defined $kraw       ? '<undef>'
                 : length($kraw) == 0   ? '<empty>'
                                        : '<set len=' . length($kraw) . '>';
        my $m    = $req->{method} // '<no method>';
        lwarn("scfg missing api_host/api_key in request (api_host=$h api_key=$k method=$m)");
        if (ref($scfg) eq 'HASH') {
            lwarn("  scfg keys: " . join(",", sort keys %$scfg));
        } else {
            lwarn("  scfg is not a HASH (ref=" . ref($scfg) . ")");
        }
        # Dump the raw line so we can tell whether the client really
        # sent a malformed envelope or whether our decode is at fault.
        # Redact any known-sensitive field before logging (defense in
        # depth; none of them should be in this code path but we still
        # don't want them in journal). Truncate to 600 bytes.
        my $raw = $line // '<undef>';
        $raw = redact_raw_line($raw);
        $raw = substr($raw, 0, 600) . (length($raw) > 600 ? "...[truncated]" : "");
        lwarn("  raw request: $raw");
        # Top-level keys of the decoded request envelope.
        if (ref($req) eq 'HASH') {
            lwarn("  request top-level keys: " . join(",", sort keys %$req));
        }
        my $err = encode_json({ error => "broker: scfg missing api_host/api_key" });
        write_all($client, "$err\n", time() + $CLIENT_READ_TIMEOUT);
        return;
    }
    my $method = $req->{method};
    my $params = $req->{params} // [];
    if (!$method) {
        lwarn("request missing method (host=$scfg->{api_host})");
        my $err = encode_json({ error => "broker: no method" });
        write_all($client, "$err\n", time() + $CLIENT_READ_TIMEOUT);
        return;
    }

    my $sk = scfg_key($scfg);
    my $result_obj;
    # One budget for the whole request - probe, reconnect, authenticate and
    # call all draw from it.
    #
    # The client applies a deadline of its own, and when the two are equal it
    # wins the race by a hair: measured at 30.03 s against a client deadline of
    # 30 s, so the operator always saw the client's generic "read timeout" and
    # never the broker's account of what actually failed. Clients that send
    # their budget get answered a margin before it expires; clients that do not
    # (older plugin builds) keep the previous behaviour.
    # The client's declared budget wins in BOTH directions, not just downwards.
    # Clamping it to the daemon default meant an operator who raised the plugin
    # side for a slow array got no change and no log line, and had to discover
    # that a second knob existed in the unit file. Bounded above so a bad value
    # cannot pin a worker for an unreasonable time.
    my $budget = $UPSTREAM_TIMEOUT;
    my $client_timeout = $req->{timeout};
    if (defined($client_timeout) && !ref($client_timeout)
        && $client_timeout =~ /^\d+(?:\.\d+)?$/ && $client_timeout > 0) {
        # The plugin records this when it sends the envelope. accept() alone
        # cannot reveal time spent in the kernel backlog while all workers run.
        # sent_mono is CLOCK_MONOTONIC, the same kernel clock in both processes,
        # so a clock step cannot expire a fresh request or revive an old one.
        # Without it (older plugin) only the time since accept() is known.
        my $sent_mono = $req->{sent_mono};
        my $elapsed;
        if (defined($sent_mono) && !ref($sent_mono) && $sent_mono =~ /^\d+(?:\.\d+)?$/ && $sent_mono > 0) {
            $elapsed = Time::HiRes::clock_gettime(Time::HiRes::CLOCK_MONOTONIC()) - $sent_mono;
        } else {
            $elapsed = time() - $accepted_at;
        }
        $elapsed = 0 if $elapsed < 0;
        my $remaining = $client_timeout - $elapsed;
        # Keep room to ANSWER before the client gives up: a result delivered after
        # its deadline is a mutation that ran and was reported as failed, which
        # the plugin may then retry. Continuous and monotonic in the deadline: 0.25 s up to 1 s (writing a
        # reply on a local socket takes microseconds), rising linearly to the
        # usual 2 s at 4 s. Halving what is left, as an earlier draft did, cut a
        # valid 0.6 s answer on a 1 s deadline - an upstream that did the work
        # and was reported as silent.
        my $margin = $remaining >= 4 ? 2
                   : $remaining <= 1 ? 0.25
                   : 0.25 + ($remaining - 1) * 1.75 / 3;
        $budget = $remaining - $margin;
        # Below the floor the request is not stretched to it: the client has all
        # but given up, so it is refused WITHOUT being executed.
        if ($budget < $MIN_CLIENT_BUDGET) {
            ++$QUEUE_EXPIRED_COUNT;
            lwarn(sprintf("request expired in queue (worker=%d count=%d method=%s remaining=%.2fs)",
                $$, $QUEUE_EXPIRED_COUNT, $method, $remaining));
            my $msg = encode_json({ error => 'broker: request expired in queue' });
            write_all($client, "$msg\n", time() + $CLIENT_READ_TIMEOUT);
            return;
        }
        $budget = $MAX_BUDGET if $budget > $MAX_BUDGET;
    }
    my $deadline = time() + $budget;
    eval {
        my $conn = get_or_open_ws($scfg, $deadline);
        my $rpc = {
            jsonrpc => "2.0", id => $conn->{next_id}++,
            method => $method, params => $params,
        };
        $result_obj = ws_rpc($conn, $rpc, $deadline);
    };
    if (my $err = $@) {
        # Drop the cached conn — likely dead — and surface the failure in
        # the journal so the operator can tell the difference between
        # "broker quiet because all RPCs succeed" and "broker quiet because
        # auth keeps failing". Before this lwarn the daemon was opaque on
        # failure: only WS lifecycle events were logged.
        lwarn("upstream RPC failed (sk=$sk method=$method): $err");
        if (my $e = delete $POOL{$sk}) {
            eval { $e->{conn}->{sock}->close(); };
        }
        my $msg = encode_json({ error => "broker: $err" });
        write_all($client, "$msg\n", time() + $CLIENT_READ_TIMEOUT);
        return;
    }
    if (!$result_obj) {
        # No response means the read gave up, and the connection is now of
        # unknown state: the answer we stopped waiting for may still arrive and
        # be sitting unread in front of the next request's. Leaving it pooled
        # also charged every following request the probe timeout for as long as
        # the outage lasted. Drop it - the die path already did; this path used
        # to put it straight back.
        lwarn("no response from upstream (sk=$sk method=$method); dropping the pooled connection");
        if (my $e = delete $POOL{$sk}) {
            eval { $e->{conn}->{sock}->close(); };
        }
        my $msg = encode_json({ error => "broker: no response from upstream" });
        write_all($client, "$msg\n", time() + $CLIENT_READ_TIMEOUT);
        return;
    }

    if (exists $result_obj->{error}) {
        # Upstream returned a structured JSON-RPC error (e.g. EBUSY /
        # Rate Limit Exceeded, invalid params, method not found). Worth
        # logging so users can match a failing test to a TN-side cause.
        my $err_repr = ref($result_obj->{error}) ? encode_json($result_obj->{error}) : $result_obj->{error};
        # Downgrade the well-known "already gone" case to INFO. A DELETE
        # against a resource that TN reports as InstanceNotFound / ENOENT
        # is a benign race the callers already handle idempotently
        # (see e.g. free_image, _teardown_snapshot_device). Leaving it
        # at WARN level drowns real errors under vzdump-* snapshot-clone
        # teardown noise: Max Carrara's test_run7 2026-08-25 3-node
        # cluster-01 logged ~2000 of these per node per subrun.
        my $is_benign_delete_enoent =
            ($method =~ /\.delete$/) &&
            ($err_repr =~ /InstanceNotFound|\bENOENT\b|does not exist/i);
        if ($is_benign_delete_enoent) {
            linfo("upstream ENOENT on $method (already gone; sk=$sk)");
        } else {
            lwarn("upstream error (sk=$sk method=$method): $err_repr");
        }
        my $msg = encode_json({ error => encode_json($result_obj->{error}) });
        write_all($client, "$msg\n", time() + $CLIENT_READ_TIMEOUT);
    } else {
        my $msg = encode_json({ result => $result_obj->{result} });
        write_all($client, "$msg\n", time() + $CLIENT_READ_TIMEOUT);
    }
}

# ---------------- main ----------------
my $srv;
my %WORKER_PIDS;   # pid => 1

# Prefork the worker pool. Parent creates listen fd, forks N children; each
# child re-runs the accept loop against the shared fd. Kernel serializes
# accept() among children so no race. Parent then waits and re-spawns any
# child that dies.
sub spawn_worker {
    my $pid = fork();
    if (!defined $pid) {
        lerr("fork worker failed: $!");
        return;
    }
    if ($pid == 0) {
        # child: close its own WS pool cleanly on TERM; do NOT touch
        # parent's socket file or pidfile.
        $SIG{TERM} = $SIG{INT} = sub {
            for my $sk (keys %POOL) {
                my $e = $POOL{$sk};
                eval { $e->{conn}->{sock}->close() if $e && $e->{conn}; };
            }
            exit 0;
        };
        $SIG{CHLD} = 'DEFAULT';
        worker_loop($srv);
        exit 0;
    }
    $WORKER_PIDS{$pid} = 1;
    ldebug("spawned worker pid=$pid");
}

sub worker_loop {
    my ($srv) = @_;
    my $sel = IO::Select->new($srv);
    my $last_reap = time();
    while (1) {
        my @ready = $sel->can_read(60);
        for my $fh (@ready) {
            if ($fh == $srv) {
                my $c = $srv->accept();
                next unless $c;
                my $accepted_at = time();
                eval { handle_request($c, $accepted_at); };
                if ($@) { lerr("handle_request died: $@"); }
                eval { $c->close(); };
            }
        }
        if (time() - $last_reap > 60) {
            reap_idle();
            $last_reap = time();
        }
    }
}

sub main {
ensure_rundir();
daemonize();
write_pidfile();
linfo("truenas-plugin-broker starting (pid=$$, socket=$SOCKET_PATH)");

$SIG{PIPE} = 'IGNORE';
# NOTE: parent SIG{TERM}/INT is set AFTER the prefork below so it can
# also propagate to the worker pool. Workers install their own TERM
# handler in spawn_worker so they close their local %POOL WS connections
# and exit cleanly without touching parent's socket / pidfile.

$srv = make_listener();

# The listen fd is now bound and listening. Workers haven't been forked
# yet, but the kernel will queue incoming connections until one does
# accept(). From a client's perspective the socket is ready, so this is
# the right moment to tell systemd we're up (Type=notify). See
# sd_notify_ready() comment for the ordering rationale.
sd_notify_ready();


# Parent: spawn N workers, then supervise
for (1..$PREFORK_N) { spawn_worker(); }
linfo("prefork pool up (N=$PREFORK_N)");

# Parent supervision loop: reap dead workers, respawn to keep pool full.
# Set the parent's TERM/INT handler HERE (after workers are up) so it
# only affects the parent process -- workers already installed their own
# in spawn_worker.
$SIG{TERM} = $SIG{INT} = sub {
    linfo("parent shutting down, signalling workers");
    kill 'TERM', keys %WORKER_PIDS;
    # Give workers a moment to close their WS cleanly.
    for (1..10) {
        last unless keys %WORKER_PIDS;
        my $dead = waitpid(-1, WNOHANG);
        if ($dead > 0) { delete $WORKER_PIDS{$dead}; }
        else { select(undef, undef, undef, 0.1); }
    }
    unlink $SOCKET_PATH;
    unlink $PIDFILE;
    exit 0;
};

while (1) {
    my $dead = waitpid(-1, 0);
    if ($dead > 0) {
        delete $WORKER_PIDS{$dead};
        lwarn("worker pid=$dead exited (status=$?), respawning");
        spawn_worker();
    }
}
}

main() unless caller;
